@{
    ViewData["Title"] = "Urban Roadworks Monitor";
    Layout = null;
}
<!DOCTYPE html>
<html lang="it">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Urban Roadworks Monitor</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/ol@latest/ol.css" />

    <link rel="stylesheet" href="~/css/map.css" />
</head>
<body>
    <div id="sidebar">
        <h1>🏗 Urban Roadworks Monitor</h1>

        <div>
            <div class="section-title">Construction Sites</div>
            <div class="filter-group">
                <label>
                    <input type="checkbox" checked onchange="applyFilters()" id="filter-sites-active" />
                    <span class="dot" style="background:#ff4444;"></span>
                    Active
                </label>
                <label>
                    <input type="checkbox" checked onchange="applyFilters()" id="filter-sites-planned" />
                    <span class="dot" style="background:#fdab43;"></span>
                    Planned
                </label>
                <label>
                    <input type="checkbox" onchange="applyFilters()" id="filter-sites-completed" />
                    <span class="dot" style="background:#6daa45;"></span>
                    Completed
                </label>
            </div>
        </div>

        <div class="divider"></div>

        <div>
            <div class="section-title">Roads</div>
            <div class="filter-group">
                <label>
                    <input type="checkbox" checked onchange="applyFilters()" id="filter-roads-closed" />
                    <span class="line-sample" style="background:#ff4444;"></span>
                    Closed
                </label>
                <label>
                    <input type="checkbox" checked onchange="applyFilters()" id="filter-roads-reduced" />
                    <span class="line-sample" style="background:#fdab43;"></span>
                    Limited traffic
                </label>
            </div>
        </div>

        <div class="divider"></div>

        <div>
            <div class="section-title">Assets</div>
            <div class="filter-group">
                <label>
                    <input type="checkbox" checked onchange="applyFilters()" id="filter-asset-temporary_traffic_light" />
                    <span class="dot" style="background:#ff4444;"></span>
                    Temporary traffic lights
                </label>
                <label>
                    <input type="checkbox" checked onchange="applyFilters()" id="filter-asset-warning_sign" />
                    <span class="dot" style="background:#fdab43;"></span>
                    Warning signs
                </label>
                <label>
                    <input type="checkbox" checked onchange="applyFilters()" id="filter-asset-site_entrance" />
                    <span class="dot" style="background:#6daa45;"></span>
                    Sites entrances
                </label>
                <label>
                    <input type="checkbox" checked onchange="applyFilters()" id="filter-asset-detour_sign" />
                    <span class="dot" style="background:#a86fdf;"></span>
                    Detour signs
                </label>
            </div>
        </div>
        <div class="divider"></div>
        <div>
            <div class="section-title">Canals</div>
            <div class="filter-group">
                <label>
                    <input type="checkbox" checked onchange="applyFilters()" id="filter-canals-active" />
                    <span class="line-sample" style="background:#4caf7d;"></span>
                    Active
                </label>
                <label>
                    <input type="checkbox" checked onchange="applyFilters()" id="filter-canals-planned" />
                    <span class="line-sample" style="background:#5ab4f7;"></span>
                    Planned
                </label>
                <label>
                    <input type="checkbox" onchange="applyFilters()" id="filter-canals-completed" />
                    <span class="line-sample" style="background:#1a80e5;"></span>
                    Completed
                </label>
            </div>
        </div>
        <div class="divider"></div>
        <div class="divider"></div>
        <div>
            <div class="section-title">Walls</div>
            <div class="filter-group">
                <label>
                    <input type="checkbox" checked onchange="applyFilters()" id="filter-walls-visible" />
                    <span class="line-sample" style="background:#90a4ae;"></span>
                    Walls
                </label>
            </div>
        </div>
        <div class="divider"></div>

        <div id="counter">
            <div>Sites: <span id="cnt-sites">–</span></div>
            <div>Roads inside sites: <span id="cnt-roads">–</span></div>
            <div>Assets: <span id="cnt-assets">–</span></div>
            <div>Canals: <span id="cnt-canals">–</span></div>
        </div>
        <div class="divider"></div>
        <div>
            <div class="section-title">Options</div>
            <div style="display:flex; flex-direction:column; gap:8px;">
                <button id="btn-add" onclick="startDrawSite()" style="background:#4f98a3;color:#fff;border:none;padding:8px 12px;border-radius:6px;cursor:pointer;font-size:0.82rem;">
                    + New site
                </button>
                <button onclick="toggleEditMode()" id="btn-edit" style="background:#2a3a5e;color:#eee;border:1px solid #4f98a3;padding:8px 12px;border-radius:6px;cursor:pointer;font-size:0.82rem;">
                    ✏️ Edit site
                </button>
                <button onclick="toggleModifySiteMode()" id="btn-modify-site"
                        style="background:#2a3a5e;color:#eee;border:1px solid #fdab43;
                                    padding:8px 12px;border-radius:6px;cursor:pointer;font-size:0.82rem;">
                    ↕️ Reshape site
                </button>
                <button onclick="startDrawAsset()" style="background:#e8af34;color:#1a1a2e;border:none;padding:8px 12px;border-radius:6px;cursor:pointer;font-size:0.82rem;">
                    + New asset
                </button>
                <button onclick="toggleAssetEditMode()" id="btn-edit-asset" style="background:#2a3a5e;color:#eee;border:1px solid #e8af34;padding:8px 12px;border-radius:6px;cursor:pointer;font-size:0.82rem;">
                    ✏️ Edit asset
                </button>
                <button onclick="toggleMoveAssetMode()" id="btn-move-asset"
                        style="background:#2a3a5e;color:#eee;border:1px solid #4f98a3;
               padding:8px 12px;border-radius:6px;cursor:pointer;font-size:0.82rem;">
                    ↕️ Move asset
                </button>
                <button onclick="startDrawCanal()" style="background:#0d3d6b;color:#eee;border:1px solid #0066cc;padding:8px 12px;border-radius:6px;cursor:pointer;font-size:0.82rem;">
                    + New canal
                </button>
                <button onclick="toggleCanalEditMode()" id="btn-edit-canal" style="background:#2a3a5e;color:#eee;border:1px solid #0066cc;padding:8px 12px;border-radius:6px;cursor:pointer;font-size:0.82rem;">
                    ✏️ Edit canal
                </button>
                <button onclick="toggleModifyCanalMode()" id="btn-modify-canal"
                        style="background:#2a3a5e;color:#eee;border:1px solid #0066cc;
                                    padding:8px 12px;border-radius:6px;cursor:pointer;font-size:0.82rem;">
                    ↕️ Reshape canal
                </button>
                <button onclick="startDrawWall()" style="background:#546e7a;color:#eee;border:1px solid #78909c;padding:8px 12px;border-radius:6px;cursor:pointer;font-size:0.82rem;">
                    + New wall
                </button>
                <button onclick="toggleWallEditMode()" id="btn-edit-wall" style="background:#2a3a5e;color:#eee;border:1px solid #78909c;padding:8px 12px;border-radius:6px;cursor:pointer;font-size:0.82rem;">
                    ✏️ Edit wall
                </button>
                <button onclick="toggleModifyWallMode()" id="btn-modify-wall" style="background:#2a3a5e;color:#eee;border:1px solid #78909c;padding:8px 12px;border-radius:6px;cursor:pointer;font-size:0.82rem;">
                    ↕️ Reshape wall
                </button>
                <button onclick="toggleQueryAreaMode()" id="btn-query-area"
                        style="background:#2a3a5e;color:#eee;border:1px solid #dd6974;
                                padding:8px 12px;border-radius:6px;cursor:pointer;font-size:0.82rem;">
                    🔲 Query area
                </button>
                <button onclick="clearQueryArea()" id="btn-clear-query"
                        style="display:none;background:#2a3a5e;color:#888;border:none;
                                padding:6px 12px;border-radius:6px;cursor:pointer;font-size:0.78rem;">
                    ✕ Clear selection
                </button>
                <div style="display:flex;gap:6px;align-items:center">
                    <button onclick="toggleNearestMode()" id="btn-query-nearest"
                            style="flex:1;background:#2a3a5e;color:#eee;border:1px solid #dd6974;
                                    padding:8px 12px;border-radius:6px;cursor:pointer;font-size:0.82rem;">
                        N nearest sites
                    </button>
                    <input type="number" id="nearest-n" min="1" max="50" value="3"
                           style="width:52px;background:#0d1b2a;border:1px solid #dd6974;color:#eee;
                                    padding:7px 6px;border-radius:5px;font-size:0.82rem;text-align:center;" />
                </div>
                <div id="query-info" style="display:none;background:#0f3e44;border-radius:6px;
                                padding:8px;font-size:0.75rem;color:#9dd;"></div>
                <div class="divider"></div>
                <div>
                    <div class="section-title">UTP Cable Planning</div>
                    <button onclick="toggleCanalSelectMode()" id="btn-canal-select"
                            style="width:100%; background:#2a3a5e; color:#eee; border:1px solid #1a80e5;
                                padding:8px 12px; border-radius:6px; cursor:pointer; font-size:0.82rem;">
                        🖱️ Select canals
                    </button>
                    <div id="cable-panel-body" style="display:flex; flex-direction:column; gap:8px; margin-top:8px;">
                        <p style="font-size:0.75rem; color:#888;">
                            Click canals on the map to select them, then calculate.
                        </p>
                        <div id="cable-selected-info"
                             style="background:#0d1b2a; border:1px solid #2a3a5e; border-radius:5px;
                    padding:6px 8px; font-size:0.75rem; color:#9dd; display:none;">
                            <span id="cable-sel-count">0</span> canal(s) selected —
                            <span id="cable-sel-meters">0</span> m total
                        </div>
                        <div style="display:flex; gap:6px;">
                            <button onclick="calculateCablePlan()" id="btn-cable-calc"
                                    style="flex:1; background:#4f98a3; color:#fff; border:none;
                           padding:8px 12px; border-radius:6px; cursor:pointer; font-size:0.82rem;">
                                ⚙️ Calculate
                            </button>
                            <button onclick="clearCablePlan()" id="btn-cable-clear"
                                    style="background:#2a3a5e; color:#888; border:none;
                           padding:8px 12px; border-radius:6px; cursor:pointer; font-size:0.78rem;">
                                ✕
                            </button>
                        </div>

                        <div id="cable-results" style="display:none; flex-direction:column; gap:6px;">
                            <div style="height:1px; background:#2a3a5e;"></div>
                            <div style="background:#0f3e44; border-radius:6px; padding:8px;
                        font-size:0.75rem; color:#9dd; display:flex; flex-direction:column; gap:3px;">
                                <div style="display:flex; justify-content:space-between;">
                                    <span>🔌 Total cable</span>
                                    <span id="cr-meters" style="font-weight:700; color:#4f98a3;">—</span>
                                </div>
                                <div style="display:flex; justify-content:space-between;">
                                    <span>📦 UTP segments (100m)</span>
                                    <span id="cr-segments" style="font-weight:700; color:#4f98a3;">—</span>
                                </div>
                                <div style="display:flex; justify-content:space-between;">
                                    <span>🔀 Nodes needed</span>
                                    <span id="cr-nodes" style="font-weight:700; color:#4f98a3;">—</span>
                                </div>
                                <div style="display:flex; justify-content:space-between;">
                                    <span>⏱️ Est. work time</span>
                                    <span id="cr-time" style="font-weight:700; color:#4f98a3;">—</span>
                                </div>
                            </div>

                            <div style="font-size:0.7rem; font-weight:600; text-transform:uppercase;
                        letter-spacing:1px; color:#4f98a3;">
                                Segments
                            </div>
                            <div id="cr-route-detail" style="display:flex; flex-direction:column; gap:3px;"></div>

                            <div style="font-size:0.7rem; font-weight:600; text-transform:uppercase;
                        letter-spacing:1px; color:#4f98a3;">
                                Walls to drill
                            </div>
                            <div id="cr-walls" style="display:flex; flex-direction:column; gap:3px;"></div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="divider"></div>
        <div>
            <div class="section-title">Driver navigation</div>
            <div style="display:flex;flex-direction:column;gap:8px;">
                <button onclick="startPickPoint('from')" id="btn-pick-from"
                        style="background:#2a3a5e;color:#eee;border:1px solid #4f98a3;
            padding:8px 12px;border-radius:6px;cursor:pointer;font-size:0.82rem;">
                    📍 Select starting point
                </button>
                <button onclick="startPickPoint('to')" id="btn-pick-to" disabled
                        style="background:#2a3a5e;color:#eee;border:1px solid #4f98a3;
            padding:8px 12px;border-radius:6px;cursor:pointer;font-size:0.82rem;">
                    🏁 Select destination
                </button>
                <button onclick="calculateRouteAB()" id="btn-route"
                        style="background:#4f98a3;color:#fff;border:none;
            padding:8px 12px;border-radius:6px;cursor:pointer;font-size:0.82rem;display:none;">
                    🗺 Calculate route
                </button>
                <button onclick="clearRoute()"
                        style="background:#2a3a5e;color:#888;border:none;
            padding:6px 12px;border-radius:6px;cursor:pointer;font-size:0.78rem;display:none;"
                        id="btn-clear-route">
                    ✕ Delete route
                </button>
                <div id="route-info" style="font-size:0.75rem;color:#9dd;display:none;
            background:#0f3e44;padding:8px;border-radius:6px;"></div>
            </div>
        </div>
        <div class="divider"></div>
        <div>
            <div class="section-title">Inspector navigation</div>
            <div style="display:flex;flex-direction:column;gap:8px;">
                <div style="font-size:0.75rem;color:#888;">Starting site:</div>
                <select id="inspector-start"
                        style="width:100%;background:#0d1b2a;border:1px solid #2a3a5e;color:#eee;
            padding:7px 10px;border-radius:5px;font-size:0.82rem;">
                    <option value="">— select —</option>
                </select>
                <div style="font-size:0.75rem;color:#888;">Sites to visit:</div>
                <div id="inspector-sites-list" style="display:flex;flex-direction:column;gap:4px;
            max-height:140px;overflow-y:auto;"></div>
                <button onclick="calculateInspectorTour()"
                        style="background:#a86fdf;color:#fff;border:none;
            padding:8px 12px;border-radius:6px;cursor:pointer;font-size:0.82rem;">
                    🔍 Compute optimal tour
                </button>
                <button onclick="clearInspectorTour()" id="btn-clear-tour"
                        style="background:#2a3a5e;color:#888;border:none;
            padding:6px 12px;border-radius:6px;cursor:pointer;font-size:0.78rem;display:none;">
                    ✕ Delete tour
                </button>
                <div id="tour-info" style="font-size:0.75rem;color:#9dd;display:none;
            background:#0f3e44;padding:8px;border-radius:6px;"></div>
            </div>
        </div>
    </div>

    <div id="map"></div>

    <div id="popup" class="ol-popup" style="display:none;"></div>

    <script src="https://cdn.jsdelivr.net/npm/ol@latest/dist/ol.js"></script>
    <script src="~/js/map-core.js"></script>
    <script src="~/js/api-client.js"></script>
    <script src="~/js/map-tools.js"></script>
    <script src="~/js/app.js"></script>

    <div id="edit-panel" style="display:none; position:fixed; top:50%; left:50%;
     transform:translate(-50%,-50%); background:#16213e; border:1px solid #4f98a3;
     border-radius:10px; padding:20px; z-index:1000; min-width:300px;
     box-shadow:0 8px 32px rgba(0,0,0,0.6);">
        <h3 style="color:#4f98a3; margin-bottom:16px; font-size:0.95rem;" id="panel-title">New construction site</h3>
        <input type="hidden" id="edit-id" />
        <input type="hidden" id="edit-geometry" />
        <div style="display:flex;flex-direction:column;gap:10px;">
            <div>
                <label style="font-size:0.78rem;color:#888;">Name</label>
                <input id="edit-name" type="text" placeholder="e.g. Renovation of Via Roma"
                       style="width:100%;background:#0d1b2a;border:1px solid #2a3a5e;color:#eee;
                padding:7px 10px;border-radius:5px;font-size:0.85rem;margin-top:3px;" />
            </div>
            <div>
                <label style="font-size:0.78rem;color:#888;">Status</label>
                <select id="edit-status"
                        style="width:100%;background:#0d1b2a;border:1px solid #2a3a5e;color:#eee;
                padding:7px 10px;border-radius:5px;font-size:0.85rem;margin-top:3px;">
                    <option value="active">Active</option>
                    <option value="planned">Planned</option>
                    <option value="completed">Completed</option>
                </select>
            </div>
            <div>
                <label style="font-size:0.78rem;color:#888;">Start date</label>
                <input id="edit-start" type="date"
                       style="width:100%;background:#0d1b2a;border:1px solid #2a3a5e;color:#eee;
                padding:7px 10px;border-radius:5px;font-size:0.85rem;margin-top:3px;" />
            </div>
            <div>
                <label style="font-size:0.78rem;color:#888;">End date</label>
                <input id="edit-end" type="date"
                       style="width:100%;background:#0d1b2a;border:1px solid #2a3a5e;color:#eee;
                padding:7px 10px;border-radius:5px;font-size:0.85rem;margin-top:3px;" />
            </div>
            <div style="display:flex;gap:8px;margin-top:6px;">
                <button onclick="saveChanges()"
                        style="flex:1;background:#4f98a3;color:#fff;border:none;padding:9px;border-radius:6px;cursor:pointer;">
                    Save
                </button>
                <button onclick="document.getElementById('edit-panel').style.display='none'; document.getElementById('overlay').style.display='none';resetButtons()"
                        style="flex:1;background:#2a3a5e;color:#eee;border:none;padding:9px;border-radius:6px;cursor:pointer;">
                    Cancel
                </button>
                <button id="btn-delete" onclick="deleteSite()"
                        style="background:rgba(220,50,50,0.3);color:#ff6b6b;border:1px solid #ff4444;padding:9px 12px;border-radius:6px;cursor:pointer;display:none;">
                    🗑
                </button>
            </div>
        </div>
    </div>
    <div id="overlay" onclick="document.getElementById('edit-panel').style.display='none';
                                document.getElementById('asset-panel').style.display='none';
                                document.getElementById('canal-panel').style.display='none';
                                document.getElementById('wall-panel').style.display='none';
                                document.getElementById('overlay').style.display='none';
                                resetButtons()"
         style="display:none;position:fixed;inset:0;background:rgba(0,0,0,0.5);z-index:999;"></div>
    <div id="asset-panel" style="display:none; position:fixed; top:50%; left:50%;
         transform:translate(-50%,-50%); background:#16213e; border:1px solid #4f98a3;
         border-radius:10px; padding:20px; z-index:1000; min-width:280px;
         box-shadow:0 8px 32px rgba(0,0,0,0.6);">
        <h3 style="color:#4f98a3; margin-bottom:16px; font-size:0.95rem;" id="asset-panel-title">New asset</h3>
        <input type="hidden" id="asset-id" />
        <input type="hidden" id="asset-geometry" />
        <div style="display:flex;flex-direction:column;gap:10px;">
            <div>
                <label style="font-size:0.78rem;color:#888;">Type</label>
                <select id="asset-type"
                        style="width:100%;background:#0d1b2a;border:1px solid #2a3a5e;color:#eee;
                    padding:7px 10px;border-radius:5px;font-size:0.85rem;margin-top:3px;">
                    <option value="temporary_traffic_light">🚦 Temporary traffic light</option>
                    <option value="warning_sign">⚠️ Warning sign</option>
                    <option value="site_entrance">🚧 Site entrance</option>
                    <option value="detour_sign">↪️ Detour sign</option>
                </select>
            </div>
            <div>
                <label style="font-size:0.78rem;color:#888;">Associated construction site</label>
                <select id="asset-site-id"
                        style="width:100%;background:#0d1b2a;border:1px solid #2a3a5e;color:#eee;
                                padding:7px 10px;border-radius:5px;font-size:0.85rem;margin-top:3px;">
                    <option value="">— none —</option>
                </select>
            </div>
            <div style="display:flex;gap:8px;margin-top:6px;">
                <button onclick="saveAsset()"
                        style="flex:1;background:#4f98a3;color:#fff;border:none;padding:9px;border-radius:6px;cursor:pointer;">
                    Save
                </button>
                <button onclick="document.getElementById('asset-panel').style.display='none'; document.getElementById('overlay').style.display='none';resetButtons()"
                        style="flex:1;background:#2a3a5e;color:#eee;border:none;padding:9px;border-radius:6px;cursor:pointer;">
                    Cancel
                </button>
                <button id="asset-btn-delete" onclick="deleteAsset()"
                        style="background:rgba(220,50,50,0.3);color:#ff6b6b;border:1px solid #ff4444;
                    padding:9px 12px;border-radius:6px;cursor:pointer;display:none;">
                    🗑
                </button>
            </div>
        </div>
    </div>
    <div id="canal-panel" style="display:none; position:fixed; top:50%; left:50%;
     transform:translate(-50%,-50%); background:#16213e; border:1px solid #0066cc;
     border-radius:10px; padding:20px; z-index:1000; min-width:300px;
     box-shadow:0 8px 32px rgba(0,0,0,0.6);">
        <h3 style="color:#0066cc; margin-bottom:16px; font-size:0.95rem;" id="canal-panel-title">New canal</h3>
        <input type="hidden" id="canal-id" />
        <input type="hidden" id="canal-geometry" />
        <div style="display:flex;flex-direction:column;gap:10px;">
            <div>
                <label style="font-size:0.78rem;color:#888;">Name</label>
                <input id="canal-name" type="text" placeholder="e.g. Via Roma → Via Mazzini"
                       style="width:100%;background:#0d1b2a;border:1px solid #2a3a5e;color:#eee;
                    padding:7px 10px;border-radius:5px;font-size:0.85rem;margin-top:3px;" />
            </div>
            <div>
                <label style="font-size:0.78rem;color:#888;">Status</label>
                <select id="canal-status"
                        style="width:100%;background:#0d1b2a;border:1px solid #2a3a5e;color:#eee;
                    padding:7px 10px;border-radius:5px;font-size:0.85rem;margin-top:3px;">
                    <option value="planned">Planned</option>
                    <option value="active">Active</option>
                    <option value="completed">Completed</option>
                </select>
            </div>
            <div style="display:flex;gap:8px;margin-top:6px;">
                <button onclick="saveCanal()"
                        style="flex:1;background:#0066cc;color:#fff;border:none;padding:9px;border-radius:6px;cursor:pointer;">
                    Save
                </button>
                <button onclick="document.getElementById('canal-panel').style.display='none';document.getElementById('overlay').style.display='none';resetButtons()"
                        style="flex:1;background:#2a3a5e;color:#eee;border:none;padding:9px;border-radius:6px;cursor:pointer;">
                    Cancel
                </button>
                <button id="canal-btn-delete" onclick="deleteCanal()"
                        style="background:rgba(220,50,50,0.3);color:#ff6b6b;border:1px solid #ff4444;
                    padding:9px 12px;border-radius:6px;cursor:pointer;display:none;">
                    🗑
                </button>
            </div>
        </div>
    </div>
    <div id="wall-panel" style="display:none; position:fixed; top:50%; left:50%;
     transform:translate(-50%,-50%); background:#16213e; border:1px solid #78909c;
     border-radius:10px; padding:20px; z-index:1000; min-width:300px;
     box-shadow:0 8px 32px rgba(0,0,0,0.6);">
        <h3 style="color:#90a4ae; margin-bottom:16px; font-size:0.95rem;" id="wall-panel-title">New wall</h3>
        <input type="hidden" id="wall-id" />
        <input type="hidden" id="wall-geometry" />
        <div style="display:flex;flex-direction:column;gap:10px;">
            <div>
                <label style="font-size:0.78rem;color:#888;">Name</label>
                <input id="wall-name" type="text" placeholder="e.g. Border wall"
                       style="width:100%;background:#0d1b2a;border:1px solid #2a3a5e;color:#eee;padding:7px 10px;border-radius:5px;font-size:0.85rem;margin-top:3px;" />
            </div>
            <div>
                <label style="font-size:0.78rem;color:#888;">Thickness (cm)</label>
                <input id="wall-thickness" type="number" min="1" max="200" value="20"
                       style="width:100%;background:#0d1b2a;border:1px solid #2a3a5e;color:#eee;padding:7px 10px;border-radius:5px;font-size:0.85rem;margin-top:3px;" />
            </div>
            <div>
                <label style="font-size:0.78rem;color:#888;">Material</label>
                <select id="wall-material" style="width:100%;background:#0d1b2a;border:1px solid #2a3a5e;color:#eee;padding:7px 10px;border-radius:5px;font-size:0.85rem;margin-top:3px;">
                    <option value="concrete">🔘 Concrete</option>
                    <option value="brick">🧱 Brick</option>
                    <option value="drywall">📋 Drywall</option>
                    <option value="stone">🪨 Stone</option>
                </select>
            </div>
            <div style="display:flex;gap:8px;margin-top:6px;">
                <button onclick="saveWall()" style="flex:1;background:#546e7a;color:#fff;border:none;padding:9px;border-radius:6px;cursor:pointer;">Save</button>
                <button onclick="document.getElementById('wall-panel').style.display='none';document.getElementById('overlay').style.display='none';resetButtons()"
                        style="flex:1;background:#2a3a5e;color:#eee;border:none;padding:9px;border-radius:6px;cursor:pointer;">
                    Cancel
                </button>
                <button id="wall-btn-delete" onclick="deleteWall()"
                        style="background:rgba(220,50,50,0.3);color:#ff6b6b;border:1px solid #ff4444;padding:9px 12px;border-radius:6px;cursor:pointer;display:none;">
                    🗑
                </button>
            </div>
        </div>
    </div>
</body>
</html>