@{
	ViewData["Title"] = "Urban Roadworks Monitor";
	Layout = null;
}
<!DOCTYPE html>
<html lang="it">
<head>
	<meta charset="UTF-8" />
	<meta name="viewport" content="width=device-width, initial-scale=1.0" />
	<title>Urban Roadworks Monitor</title>
	<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/ol@latest/ol.css" />
	<style>
		* {
			margin: 0;
			padding: 0;
			box-sizing: border-box;
		}

		body {
			font-family: 'Segoe UI', sans-serif;
			display: flex;
			height: 100vh;
			overflow: hidden;
			background: #1a1a2e;
			color: #eee;
		}

		#sidebar {
			width: 280px;
			min-width: 280px;
			background: #16213e;
			display: flex;
			flex-direction: column;
			padding: 16px;
			gap: 16px;
			overflow-y: auto;
			z-index: 10;
			box-shadow: 2px 0 12px rgba(0,0,0,0.4);
		}

			#sidebar h1 {
				font-size: 1rem;
				font-weight: 700;
				color: #4f98a3;
				letter-spacing: 0.5px;
				border-bottom: 1px solid #2a3a5e;
				padding-bottom: 10px;
			}

		.section-title {
			font-size: 0.7rem;
			font-weight: 600;
			text-transform: uppercase;
			letter-spacing: 1px;
			color: #4f98a3;
			margin-bottom: 8px;
		}

		.filter-group {
			display: flex;
			flex-direction: column;
			gap: 6px;
		}

			.filter-group label {
				display: flex;
				align-items: center;
				gap: 8px;
				font-size: 0.82rem;
				cursor: pointer;
				padding: 5px 8px;
				border-radius: 6px;
				transition: background 0.15s;
			}

				.filter-group label:hover {
					background: rgba(79,152,163,0.12);
				}

			.filter-group input[type="checkbox"] {
				accent-color: #4f98a3;
				width: 14px;
				height: 14px;
			}

		.dot {
			width: 10px;
			height: 10px;
			border-radius: 50%;
			flex-shrink: 0;
		}

		.line-sample {
			width: 22px;
			height: 4px;
			border-radius: 2px;
			flex-shrink: 0;
		}

		#legend {
			display: flex;
			flex-direction: column;
			gap: 6px;
		}

		.legend-item {
			display: flex;
			align-items: center;
			gap: 8px;
			font-size: 0.78rem;
			color: #bbb;
		}

		#counter {
			background: #0f3e44;
			border-radius: 8px;
			padding: 10px;
			font-size: 0.78rem;
			color: #9dd;
		}

			#counter div {
				display: flex;
				justify-content: space-between;
				margin-bottom: 3px;
			}

			#counter span {
				font-weight: 700;
				color: #4f98a3;
			}

		#map {
			flex: 1;
			height: 100vh;
		}

		.ol-popup {
			position: absolute;
			background: #16213e;
			border: 1px solid #4f98a3;
			border-radius: 8px;
			padding: 12px 14px;
			min-width: 180px;
			max-width: 240px;
			font-size: 0.82rem;
			color: #eee;
			pointer-events: auto;
			box-shadow: 0 4px 16px rgba(0,0,0,0.5);
		}

		.popup-close {
			position: absolute;
			top: 6px;
			right: 8px;
			cursor: pointer;
			font-size: 1rem;
			color: #888;
			background: none;
			border: none;
			line-height: 1;
		}

			.popup-close:hover {
				color: #eee;
			}

		.ol-popup h4 {
			font-size: 0.88rem;
			color: #4f98a3;
			margin-bottom: 6px;
		}

		.ol-popup p {
			color: #bbb;
			margin-bottom: 3px;
		}

		.badge {
			display: inline-block;
			padding: 2px 8px;
			border-radius: 12px;
			font-size: 0.72rem;
			font-weight: 600;
			margin-top: 4px;
		}

		.badge-active {
			background: rgba(220,50,50,0.25);
			color: #ff6b6b;
		}

		.badge-planned {
			background: rgba(150,150,150,0.2);
			color: #fdab43;
		}

		.badge-completed {
			background: rgba(70,180,80,0.2);
			color: #6daa45;
		}

		.divider {
			height: 1px;
			background: #2a3a5e;
		}

		button:disabled {
			opacity: 0.4;
			cursor: not-allowed !important;
		}
	</style>
</head>
<body>

	<div id="sidebar">

		<h1>🏗 Urban Roadworks Monitor</h1>

		<div>
			<div class="section-title">Construction Sites</div>
			<div class="filter-group">
				<label>
					<input type="checkbox" checked onchange="applyFilters()"
						   id="filter-sites-active" />
					<span class="dot" style="background:#ff4444;"></span>
					Active
				</label>
				<label>
					<input type="checkbox" checked onchange="applyFilters()"
						   id="filter-sites-planned" />
					<span class="dot" style="background:#fdab43;"></span>
					Planned
				</label>
				<label>
					<input type="checkbox" onchange="applyFilters()"
						   id="filter-sites-completed" />
					<span class="dot" style="background:#6daa45;"></span>
					Completed
				</label>
			</div>
		</div>

		<div class="divider"></div>

		<div>
			<div class="section-title">Roads</div>
			<div class="filter-group">
				<label>
					<input type="checkbox" checked onchange="applyFilters()"
						   id="filter-roads-closed" />
					<span class="line-sample" style="background:#ff4444;"></span>
					Closed
				</label>
				<label>
					<input type="checkbox" checked onchange="applyFilters()"
						   id="filter-roads-reduced" />
					<span class="line-sample" style="background:#fdab43;"></span>
					Limited traffic
				</label>
			</div>
		</div>

		<div class="divider"></div>

		<div>
			<div class="section-title">Assets</div>
			<div class="filter-group">
				<label>
					<input type="checkbox" checked onchange="applyFilters()"
						   id="filter-asset-temporary_traffic_light" />
					<span class="dot" style="background:#ff4444;"></span>
					Temporary traffic lights
				</label>
				<label>
					<input type="checkbox" checked onchange="applyFilters()"
						   id="filter-asset-warning_sign" />
					<span class="dot" style="background:#fdab43;"></span>
					Warning signs
				</label>
				<label>
					<input type="checkbox" checked onchange="applyFilters()"
						   id="filter-asset-site_entrance" />
					<span class="dot" style="background:#6daa45;"></span>
					Sites entrances
				</label>
				<label>
					<input type="checkbox" checked onchange="applyFilters()"
						   id="filter-asset-detour_sign" />
					<span class="dot" style="background:#a86fdf;"></span>
					Detour signs
				</label>
			</div>
		</div>
		<div class="divider"></div>

		<div>
			<div class="section-title">Canals</div>
			<div class="filter-group">
				<label>
					<input type="checkbox" checked onchange="applyFilters()"
						   id="filter-canals-visible" />
					<span class="line-sample" style="background:#0066cc;"></span>
					Cable canals
				</label>
			</div>
		</div>
		<div class="divider"></div>

		<div id="counter">
			<div>Sites: <span id="cnt-sites">–</span></div>
			<div>Roads inside sites: <span id="cnt-roads">–</span></div>
			<div>Assets: <span id="cnt-assets">–</span></div>
			<div>Canals: <span id="cnt-canals">–</span></div>
		</div>

		<div class="divider"></div>

		<!-- Legenda automatica -->
		<div>
			<div class="section-title">Legend</div>
			<div id="legend">
				<div class="legend-item">
					<span class="dot" style="background:#ff6b6b; opacity:0.7;"></span>
					Active sites
				</div>
				<div class="legend-item">
					<span class="dot" style="background:#fdab43; opacity:0.7;"></span>
					Planned sites
				</div>
				<div class="legend-item">
					<span class="dot" style="background:#6daa45; opacity:0.7;"></span>
					Completed sites
				</div>
				<div class="legend-item">
					<span class="line-sample" style="background:#ff4444;"></span>
					Closed roads
				</div>
				<div class="legend-item">
					<span class="line-sample" style="background:#fdab43;"></span>
					Limited-traffic roads
				</div>
				<div class="legend-item">
					<span class="line-sample" style="background:#5591c7;"></span>
					Alternative routes
				</div>
				<div class="legend-item">
					<span class="line-sample" style="background:#0066cc;"></span>
					Cable canals
				</div>
			</div>
		</div>
		<div class="divider"></div>
		<div>
			<div class="section-title">Options</div>
			<div style="display:flex; flex-direction:column; gap:8px;">
				<button id="btn-add" onclick="startDrawSite()" style="background:#4f98a3;color:#fff;border:none;padding:8px 12px;border-radius:6px;cursor:pointer;font-size:0.82rem;">
					+ New site
				</button>
				<button onclick="toggleEditMode()" id="btn-edit" style="background:#2a3a5e;color:#eee;border:1px solid #4f98a3;padding:8px 12px;border-radius:6px;cursor:pointer;font-size:0.82rem;">
					✏️ Edit state
				</button>
				<button onclick="startDrawAsset()" style="background:#e8af34;color:#1a1a2e;border:none;padding:8px 12px;border-radius:6px;cursor:pointer;font-size:0.82rem;">
					+ New asset
				</button>
				<button onclick="toggleAssetEditMode()" id="btn-edit-asset" style="background:#2a3a5e;color:#eee;border:1px solid #e8af34;padding:8px 12px;border-radius:6px;cursor:pointer;font-size:0.82rem;">
					✏️ Edit asset
				</button>
				<button onclick="toggleMoveAssetMode()" id="btn-move-asset"
						style="background:#2a3a5e;color:#eee;border:1px solid #4f98a3;
               padding:8px 12px;border-radius:6px;cursor:pointer;font-size:0.82rem;">
					↕️ Move asset
				</button>
				<button onclick="startDrawCanal()" style="background:#0d3d6b;color:#eee;border:1px solid #0066cc;padding:8px 12px;border-radius:6px;cursor:pointer;font-size:0.82rem;">
					+ New canal
				</button>
				<button onclick="toggleCanalEditMode()" id="btn-edit-canal" style="background:#2a3a5e;color:#eee;border:1px solid #0066cc;padding:8px 12px;border-radius:6px;cursor:pointer;font-size:0.82rem;">
					✏️ Edit canal
				</button>
			</div>
		</div>
		<div class="divider"></div>
		<div>
			<div class="section-title">Driver navigation</div>
			<div style="display:flex;flex-direction:column;gap:8px;">
				<button onclick="startPickPoint('from')" id="btn-pick-from"
						style="background:#2a3a5e;color:#eee;border:1px solid #4f98a3;
            padding:8px 12px;border-radius:6px;cursor:pointer;font-size:0.82rem;">
					📍 Select starting point
				</button>
				<button onclick="startPickPoint('to')" id="btn-pick-to" disabled
						style="background:#2a3a5e;color:#eee;border:1px solid #4f98a3;
            padding:8px 12px;border-radius:6px;cursor:pointer;font-size:0.82rem;">
					🏁 Select destination
				</button>
				<button onclick="calculateRouteAB()" id="btn-route"
						style="background:#4f98a3;color:#fff;border:none;
            padding:8px 12px;border-radius:6px;cursor:pointer;font-size:0.82rem;display:none;">
					🗺 Calculate route
				</button>
				<button onclick="clearRoute()"
						style="background:#2a3a5e;color:#888;border:none;
            padding:6px 12px;border-radius:6px;cursor:pointer;font-size:0.78rem;display:none;"
						id="btn-clear-route">
					✕ Delete route
				</button>
				<div id="route-info" style="font-size:0.75rem;color:#9dd;display:none;
            background:#0f3e44;padding:8px;border-radius:6px;"></div>
			</div>
		</div>
		<div class="divider"></div>
		<div>
			<div class="section-title">Inspector navigation</div>
			<div style="display:flex;flex-direction:column;gap:8px;">
				<div style="font-size:0.75rem;color:#888;">Starting site:</div>
				<select id="inspector-start"
						style="width:100%;background:#0d1b2a;border:1px solid #2a3a5e;color:#eee;
            padding:7px 10px;border-radius:5px;font-size:0.82rem;">
					<option value="">— select —</option>
				</select>
				<div style="font-size:0.75rem;color:#888;">Sites to visit:</div>
				<div id="inspector-sites-list" style="display:flex;flex-direction:column;gap:4px;
            max-height:140px;overflow-y:auto;"></div>
				<button onclick="calculateInspectorTour()"
						style="background:#a86fdf;color:#fff;border:none;
            padding:8px 12px;border-radius:6px;cursor:pointer;font-size:0.82rem;">
					🔍 Compute optimal tour
				</button>
				<button onclick="clearInspectorTour()" id="btn-clear-tour"
						style="background:#2a3a5e;color:#888;border:none;
            padding:6px 12px;border-radius:6px;cursor:pointer;font-size:0.78rem;display:none;">
					✕ Delete tour
				</button>
				<div id="tour-info" style="font-size:0.75rem;color:#9dd;display:none;
            background:#0f3e44;padding:8px;border-radius:6px;"></div>
			</div>
		</div>
	</div>

	<div id="map"></div>

	<div id="popup" class="ol-popup" style="display:none;"></div>

	<script src="https://cdn.jsdelivr.net/npm/ol@latest/dist/ol.js"></script>
	<script>

		let allSites  = [];
		let allAssets = [];
		let allAffectedRoads = [];
		let allCanals = [];
		let drawSite = null;
		let drawAsset = null;
		let drawCanal = null;
		let translateInteraction = null;

		const sitesSource  = new ol.source.Vector();
		const assetsSource = new ol.source.Vector();
		const affectedRoadsSource = new ol.source.Vector();
		const networkSource = new ol.source.Vector();
		const canalsSource = new ol.source.Vector();

		const canalsLayer  = new ol.layer.Vector({
			source: canalsSource,
			style: new ol.style.Style({
				stroke: new ol.style.Stroke({ color: '#1a80e5', width: 4 })
			}),
			zIndex: 2
		});

		const networkLayer = new ol.layer.Vector({
			source: networkSource,
			style: new ol.style.Style({
				stroke: new ol.style.Stroke({ color: '#555', width: 1 })
			}),
			zIndex: 0
		});

		function siteStyle(feature) {
			const status = feature.get('status');
			const colors = {
				active:    { fill: 'rgba(255,107,107,0.25)', stroke: '#ff4444' },
				planned:   { fill: 'rgba(150,150,150,0.2)',  stroke: '#fdab43' },
				completed: { fill: 'rgba(109,170,69,0.2)',   stroke: '#6daa45' }
			};
			const c = colors[status] || colors.planned;
			return new ol.style.Style({
				fill:   new ol.style.Fill({ color: c.fill }),
				stroke: new ol.style.Stroke({ color: c.stroke, width: 2 })
			});
		}

		function roadStyle(feature) {
			const status = feature.get('siteStatus');
			const colors = {
				active:  { color: '#ff4444', width: 4 },
				planned: { color: '#fdab43', width: 3 }
			};
			const c = colors[status] || { color: '#888', width: 2 };
			return new ol.style.Style({
				stroke: new ol.style.Stroke({ color: c.color, width: c.width })
			});
		}

		function assetStyle(feature) {
			const type = feature.get('assetType');
			const colors = {
				temporary_traffic_light: '#ff4444',
				warning_sign:            '#fdab43',
				site_entrance:           '#6daa45',
				detour_sign:             '#a86fdf'
			};
			const color = colors[type] || '#aaa';
			return new ol.style.Style({
				image: new ol.style.Circle({
					radius: 8,
					fill:   new ol.style.Fill({ color }),
					stroke: new ol.style.Stroke({ color: '#fff', width: 1.5 })
				})
			});
		}

		const sitesLayer  = new ol.layer.Vector({ source: sitesSource,  style: siteStyle,  zIndex: 1 });
		const assetsLayer = new ol.layer.Vector({ source: assetsSource, style: assetStyle, zIndex: 3 });
				const affectedRoadsLayer = new ol.layer.Vector({
			source: affectedRoadsSource,
			style: function(feature) {
				const status = feature.get('siteStatus');
				return new ol.style.Style({
					stroke: new ol.style.Stroke({
						color: status === 'active' ? '#ff4444' : '#fdab43',
						width: 4,
						lineDash: [8, 4]
					})
				});
			},
			zIndex: 4
		});

		const map = new ol.Map({
			target: 'map',
			layers: [
				new ol.layer.Tile({ source: new ol.source.OSM() }),
				networkLayer,
				canalsLayer,
				sitesLayer,
				assetsLayer,
				affectedRoadsLayer
			],
			view: new ol.View({
				center: ol.proj.fromLonLat([13.0680, 43.1360]),
				zoom: 15
			})
		});

		const popup = document.getElementById('popup');
		map.on('click', async function(evt) {
			if (pickMode) {
				const coord = ol.proj.toLonLat(evt.coordinate);
				// Remove previous marker of the same type
				routeMarkersSource.getFeatures()
					.filter(f => f.get('pointType') === pickMode)
					.forEach(f => routeMarkersSource.removeFeature(f));
				// Add new marker
				const marker = new ol.Feature({ geometry: new ol.geom.Point(evt.coordinate) });
				marker.set('pointType', pickMode);
				routeMarkersSource.addFeature(marker);
				if (pickMode === 'from') {
					routeFrom = coord;
					document.getElementById('btn-pick-from').style.background = '#2a3a5e';
					document.getElementById('btn-pick-to').disabled = false;
				} else {
					routeTo = coord;
					document.getElementById('btn-pick-to').style.background = '#2a3a5e';
				}
				pickMode = null;
				map.getTargetElement().style.cursor = '';
				// Show 'compute' button only if both points are given
				if (routeFrom && routeTo) {
					document.getElementById('btn-route').style.display = 'block';
				}
				return;
			}
			// popup feature
			const feature = map.forEachFeatureAtPixel(evt.pixel, f => f);
			if (feature) {
				const props = feature.getProperties();
				let html = '';
				if (modes.editSite.active  && props.id && props.status && !props.assetType) {
					openEditPanel(props);      
					return; 
				}
				if (modes.editAsset.active && props.id && props.assetType) { 
					openAssetEditPanel(props);  
					return; 
				}
				if (modes.editCanal.active && props.id && props.status && !props.assetType && !props.siteStatus) { 
					openCanalEditPanel(props);  
					return; 
				}
				if (props.name) {
					const badgeClass = 'badge-' + (props.status || 'planned');
					html = `<h4>${props.name}</h4>
							<span class="badge ${badgeClass}">${props.status || ''}</span>
							${props.startDate ? `<p style="margin-top:6px">Start: ${props.startDate}</p>` : ''}
							${props.endDate   ? `<p>End: ${props.endDate}</p>` : ''}`;
				} else if (props.assetType) {
					const labels = {
						temporary_traffic_light: '🚦 Temporary traffic light',
						warning_sign:            '⚠️ Warning sign',
						site_entrance:           '🚧 Site entrance',
						detour_sign:             '↪️ Detour sign'
					};
					html = `<h4>${labels[props.assetType] || props.assetType}</h4>`;
				}
				if (html) {
					popup.innerHTML = `<button class="popup-close"
						onclick="document.getElementById('popup').style.display='none'">✕</button>` + html;
					popup.style.display = 'block';
					popup.style.left = (evt.pixel[0] + 12) + 'px';
					popup.style.top  = (evt.pixel[1] - 10) + 'px';
				}
				return; // doesn't do proximity if you've clicked on a feature
			}

			popup.style.display = 'none';

		});

		map.on('pointermove', function(evt) {
			const anyActive = Object.values(modes).some(m => m.active);
			if (pickMode || anyActive) return;
			const hit = map.hasFeatureAtPixel(evt.pixel);
			map.getTargetElement().style.cursor = map.hasFeatureAtPixel(evt.pixel) ? 'pointer' : '';
		});

		function startDrawSite() {
			resetButtons();

			const btn = document.getElementById('btn-add');
			btn.textContent = '🖊 Draw the perimeter...';
			btn.style.background = '#e8af34';

			const drawSource = new ol.source.Vector();
			drawSite = new ol.interaction.Draw({
				source: drawSource,
				type: 'Polygon'
			});

			drawSite.on('drawend', function(evt) {
				// Converts geometry in WKT 4326
				const wkt = new ol.format.WKT().writeFeature(evt.feature, {
					dataProjection: 'EPSG:4326',
					featureProjection: 'EPSG:3857'
				});
				// Saves WKT in the hidden field of the form
				document.getElementById('edit-geometry').value = wkt;

				// Remove interaction and restore the button
				map.removeInteraction(drawSite);
				drawSite = null;
				btn.textContent = '+ New construction site';
				btn.style.background = '#4f98a3';

				// Open form
				document.getElementById('panel-title').textContent = 'New construction site';
				document.getElementById('edit-id').value = '';
				document.getElementById('edit-name').value = '';
				document.getElementById('edit-status').value = 'active';
				document.getElementById('edit-start').value = '';
				document.getElementById('edit-end').value = '';
				document.getElementById('btn-delete').style.display = 'none';
				document.getElementById('edit-panel').style.display = 'block';
				document.getElementById('overlay').style.display = 'block';
			});

			map.addInteraction(drawSite);
		}

		function startDrawAsset() {
			
			resetButtons();
			
			map.getTargetElement().style.cursor = 'crosshair';

			const btn = document.querySelector('[onclick="startDrawAsset()"]');
			btn.textContent = '📍 Click on the map...';
