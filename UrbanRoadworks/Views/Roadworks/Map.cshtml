						await loadAllData();
					});
					map.addInteraction(translateInteraction);
				},
				onDeactivate: function() {
					if (translateInteraction) {
						map.removeInteraction(translateInteraction);
						translateInteraction = null;
					}
				}
			},
			editCanal: {
