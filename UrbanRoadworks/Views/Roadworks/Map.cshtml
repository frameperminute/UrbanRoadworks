				active:    { fill: 'rgba(255,107,107,0.25)', stroke: '#ff4444' },
				planned:   { fill: 'rgba(150,150,150,0.2)',  stroke: '#fdab43' },
				completed: { fill: 'rgba(109,170,69,0.2)',   stroke: '#6daa45' }
